#   tok-operator-ot    role operator_ot    (OT : lecture + commandes procede)
#   tok-maintenance    role maintenance    (prestataire : lecture d'etat, JIT)
#   tok-expire         jeton deja expire   (demo "verifier en continu")
STOLEN_TOKEN=tok-admin-it
OPERATOR_TOKEN=tok-operator-ot

# --- Mini-LMS (sign-in etudiant, notes, rapport) --------------------------- #
# Destinataire du rapport de notes et code pour le telecharger.
